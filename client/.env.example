# API Django/DRF
VITE_API_URL=https://ledevfreelance.pythonanywhere.com/api/v1

# Google Identity Services
# IMPORTANT: use a Google OAuth 2.0 Web Client ID authorized for the deployed domain.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

# Backend endpoint that validates the Google credential and returns:
# { "token": "...", "user": { ... } }
VITE_GOOGLE_AUTH_PATH=/users/auth/google/
