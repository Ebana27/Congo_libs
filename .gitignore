#################################
# Fichiers et dossiers généraux
#################################

# Fichiers de configuration locaux
.env
.env*.local
.env*.private

# Fichiers de cache
.cache/
.DS_Store
*.swp
*.swo

# Fichiers temporaires
*.tmp
*.temp
*.bak
*.orig

# Fichiers de log
*.log
logs/

#################################
# Node.js et npm/yarn/pnpm
#################################

# Dossiers de dépendances
node_modules/
**/node_modules/

# Fichiers de verrouillage
package-lock.json
npm-lock.json
yarn.lock
pnpm-lock.yaml

# Fichiers de build
dist/
build/
.next/
out/

# Fichiers de cache de npm/yarn/pnpm
**/.npm
**/.yarn
**/.pnpm-store

#################################
# Python et Django (Backend)
#################################

# Dossier Backend complet
Backend/

# Environnements virtuels
.venv/
venv/
env/

# Fichiers Python
__pycache__/
*.py[cod]
*.pyc
*.pyd

# Dossiers générés
*.egg-info/
*.dist-info/
build/
dist/

# Fichiers de base de données
*.sqlite3
*.db

# Fichiers de cache et de log
.pytest_cache/
.coverage
*.coveragerc

#################################
# Vite et React (Client)
#################################

# Dossier Client complet
client/

