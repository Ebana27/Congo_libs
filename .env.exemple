POSTGRES_DB=nom_base_de_donnees
POSTGRES_USER=nom_utilisateur
POSTGRES_PASSWORD=ton_mot_de_passe
POSTGRES_HOST=db
POSTGRES_PORT=5432

DEBUG=False
SECRET_KEY=change-me-with-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1],backend,example.com

# HTTPS / proxy settings (activate in production behind a TLS proxy or load balancer)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
USE_X_FORWARDED_HOST=True
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1,https://example.com

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@example.com
MAILER_BACKEND=django.core.mail.backends.smtp.EmailBackend